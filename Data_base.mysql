-- 1. Sélectionner ta base
USE projet_match;

-- 2. Table utilisateur
CREATE TABLE UTILISATEUR (
    id_utilisateur INT PRIMARY KEY AUTO_INCREMENT,
    nom VARCHAR(100) NOT NULL,
    prenom VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    telephone VARCHAR(20) NOT NULL UNIQUE,
    mot_de_passe VARCHAR(255) NOT NULL,
    photo_profil VARCHAR(255),
    filiere ENUM('IA', 'IM', 'GL', 'SE&IoT', 'SI') NOT NULL,
    niveau ENUM('L1', 'L2', 'L3') NOT NULL,
    bio TEXT,
    centre_interet TEXT,
    date_inscription DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL
);

-- 3. Table COMPÉTENCE
CREATE TABLE COMPETENCE (
    id_competence INT PRIMARY KEY AUTO_INCREMENT
     
);

-- 4. Table UTILISATEUR_COMPÉTENCE
CREATE TABLE UTILISATEUR_COMPETENCE (
    id_util_comp INT PRIMARY KEY AUTO_INCREMENT,
    id_utilisateur INT NOT NULL UNIQUE,
    id_competence INT NOT NULL UNIQUE ,
    type_competence ENUM('point_fort', 'point_faible') NOT NULL UNIQUE ,
    FOREIGN KEY (id_utilisateur) REFERENCES UTILISATEUR(id_utilisateur),
    FOREIGN KEY (id_competence) REFERENCES COMPETENCE(id_competence)
); 
 
-- 5. Table DISPONIBILITÉ
CREATE TABLE DISPONIBILITE (
    id_disponibilite INT PRIMARY KEY AUTO_INCREMENT,
    id_utilisateur INT NOT NULL,
    jour ENUM('Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche') NOT NULL,
    heure_debut TIME NOT NULL,
    heure_fin TIME NOT NULL,
    FOREIGN KEY (id_utilisateur) REFERENCES UTILISATEUR(id_utilisateur)
);

-- 6. Table OFFRE_MENTORAT
CREATE TABLE OFFRE_MENTORAT (
    id_offre INT PRIMARY KEY AUTO_INCREMENT,
    id_utilisateur INT NOT NULL,
    id_competence INT NOT NULL,
    type_offre ENUM('offre', 'demande') NOT NULL,
    format ENUM('présentiel', 'en ligne', 'les deux') NOT NULL,
    statut ENUM('ouverte', 'fermée') NOT NULL,
    date_publication DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_utilisateur) REFERENCES UTILISATEUR(id_utilisateur),
    FOREIGN KEY (id_competence) REFERENCES COMPETENCE(id_competence)
);

-- 7. Table MATCHING
CREATE TABLE MATCHING (
    id_matching INT PRIMARY KEY AUTO_INCREMENT,
    id_mentor INT NOT NULL,
    id_mentore INT NOT NULL,
    id_offre INT NOT NULL,
    score DECIMAL(5,2) NOT NULL CHECK (score >= 0 AND score <= 100),
    statut ENUM('proposé', 'accepté', 'refusé') NOT NULL,
    date_matching DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_mentor) REFERENCES UTILISATEUR(id_utilisateur),
    FOREIGN KEY (id_mentore) REFERENCES UTILISATEUR(id_utilisateur),
    FOREIGN KEY (id_offre) REFERENCES  OFFRE_MENTORAT(id_offre)
);

-- 8. Table CONVERSATION
CREATE TABLE CONVERSATION (
    id_conversation INT PRIMARY KEY AUTO_INCREMENT,
    id_utilisateur1 INT NOT NULL,
    id_utilisateur2 INT NOT NULL,
    date_creation DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_utilisateur1) REFERENCES UTILISATEUR(id_utilisateur),
    FOREIGN KEY (id_utilisateur2) REFERENCES UTILISATEUR(id_utilisateur)
);

-- 9. Table MESSAGE
CREATE TABLE MESSAGE (
    id_message INT PRIMARY KEY AUTO_INCREMENT,
    id_conversation INT NOT NULL,
    id_expediteur INT NOT NULL,
    contenu TEXT NOT NULL,
    date_envoi DATETIME DEFAULT CURRENT_TIMESTAMP,
    lu BOOLEAN DEFAULT FALSE,
    FOREIGN KEY (id_conversation) REFERENCES CONVERSATION(id_conversation),
    FOREIGN KEY (id_expediteur) REFERENCES UTILISATEUR(id_utilisateur)
);

-- Modifier la table pour ajouter la catégorie
ALTER TABLE COMPETENCE
ADD COLUMN categorie VARCHAR(100) NOT NULL;

